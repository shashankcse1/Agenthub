# Production environment template for Enterprise Multi-Agent Platform API
# Copy to deployment secret manager or environment-specific .env file.
# This file is intentionally minimal: only startup/security-critical controls live here.
# Non-startup operational tuning should be stored in database runtime_config.

# Runtime profile
APP_ENV=production
# ENVIRONMENT is a backward-compatibility alias for APP_ENV and should remain unset.

# Core database and API runtime
DATABASE_URL=postgresql+psycopg://<db-user>@<db-host>:5432/agenthub
DB_POOL_PRE_PING_DEFAULT=true
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS_DEFAULT=1800
DB_POOL_RECYCLE_SECONDS_MIN=60
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_SIZE_DEFAULT=10
DB_POOL_SIZE_MIN=1
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW_DEFAULT=20
DB_POOL_MAX_OVERFLOW_MIN=0
DB_POOL_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS_DEFAULT=30
DB_POOL_TIMEOUT_SECONDS_MIN=1
DB_POOL_TIMEOUT_SECONDS=30
STARTUP_AUTO_CREATE_SCHEMA=false

# Session token secrets (prefer key-ring signing in production)
SESSION_TOKEN_SIGNING_KEYS=k2:<new-strong-secret-32-plus>,k1:<previous-strong-secret-32-plus>
SESSION_TOKEN_SIGNING_LAST_ROTATED_AT=2026-06-05T00:00:00Z
SESSION_TOKEN_ROTATION_MAX_DAYS=30
# Optional legacy fallback only during migration windows:
# SESSION_TOKEN_SECRET=<legacy-strong-secret-32-plus-characters>

# Authentication posture controls (must remain secure in production)
ALLOW_HEADER_ACTOR_AUTH=false
MFA_ENFORCEMENT_OPTIONAL=false
EXPOSE_WORKLOAD_IDENTITY_ACCESS_TOKEN=false

# CORS and browser security integration
# Example: https://ui.agenthub.example.com,https://ops.agenthub.example.com
CORS_ALLOW_ORIGINS=https://ui.agenthub.example.com

# Distributed rate limiting
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://<redis-host>:6379/0
RATE_LIMIT_REDIS_PREFIX=rate-limit
RATE_LIMIT_REDIS_RETRY_SECONDS=30
RATE_LIMIT_DEGRADED_ALERT_ATTEMPTS=10

# Optional SIEM/webhook startup alert integration
SECURITY_ALERT_WEBHOOK_URL=https://siem.example.com/webhook
SECURITY_ALERT_WEBHOOK_TIMEOUT_SECONDS=2.0

# Runtime config should hold non-startup defaults (examples):
# - workload_identity.default_expires_in_seconds
# - workload_identity.default_http_timeout_seconds
# - rate_limit.rules_exact_json
# - rate_limit.rules_wildcard_json
# - rate_limit.rules_refresh_seconds
# - gateway.default_global_timeout_ms
# - gateway.default_max_fallback_hops

# Runtime-injected AI vendor tokens are optional and only needed if you want to
# test token exchange for a specific provider in a non-production environment.
# OPENAI_WORKLOAD_IDENTITY_ACCESS_TOKEN=
# OPENAI_WORKLOAD_IDENTITY_EXPIRES_IN=1800

# Optional local/test interoperability flags should remain unset in production.
# PGPASSWORD=
# PGPASSFILE=
