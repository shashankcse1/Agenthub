# Copy this file to .env.production and fill secure values before deploy.

POSTGRES_DB=agenthub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password

# Backend security-critical values
APP_ENV=production
STARTUP_AUTO_CREATE_SCHEMA=false
SESSION_TOKEN_SIGNING_KEYS=k2:replace-with-strong-secret-32-plus,k1:replace-with-previous-strong-secret
CORS_ALLOW_ORIGINS=https://ui.agenthub.example.com
ALLOW_HEADER_ACTOR_AUTH=false
MFA_ENFORCEMENT_OPTIONAL=false
EXPOSE_WORKLOAD_IDENTITY_ACCESS_TOKEN=false

# Rate limit backend
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
RATE_LIMIT_REDIS_PREFIX=rate-limit
RATE_LIMIT_REDIS_RETRY_SECONDS=30
RATE_LIMIT_DEGRADED_ALERT_ATTEMPTS=10

# API process sizing
UVICORN_WORKERS=4
