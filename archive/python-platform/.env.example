APP_ENV=prod
ALLOW_BASIC_AUTH=false
# If ALLOW_BASIC_AUTH=true, set these via secret manager injection.
# BASIC_AUTH_PLATFORM_ADMIN_PASSWORD=
# BASIC_AUTH_SECURITY_APPROVER_PASSWORD=
# BASIC_AUTH_AUDITOR_PASSWORD=
JWT_SIGNING_SECRET=replace-with-strong-secret
JWT_ISSUER=newdesign-platform
JWT_AUDIENCE=newdesign-platform-api
AUDIT_SIGNING_SECRET=replace-with-strong-audit-secret
EVIDENCE_STORAGE_MODE=append_jsonl
EVIDENCE_STORE_PATH=/tmp/agent_platform_evidence.jsonl
EVIDENCE_RETENTION_DAYS=30
EVIDENCE_LEGAL_HOLD_ENABLED=false
HOST_PORT=8080
IMAGE_NAME=newdesign/python-platform:local
