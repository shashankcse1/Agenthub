{
  "manifest_version": 2,
  "name": "GuardBridge Browser Security",
  "version": "0.1.0",
  "description": "Guard browser AI interactions with minimal telemetry and policy-aware controls.",
  "permissions": ["storage", "tabs", "alarms", "http://127.0.0.1:8000/*", "https://*/*", "http://*/*"],
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "guardbridge@example.com",
      "strict_min_version": "115.0"
    }
  },
  "browser_action": {
    "default_title": "GuardBridge"
  }
}
