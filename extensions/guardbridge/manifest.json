{
  "manifest_version": 3,
  "name": "GuardBridge Browser Security",
  "short_name": "GuardBridge",
  "version": "0.1.0",
  "description": "Guard browser AI interactions with minimal telemetry and policy-aware controls.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:8000/*", "https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "GuardBridge"
  }
}
