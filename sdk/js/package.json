{
  "name": "@agenthub/gateway-sdk",
  "version": "0.1.0",
  "description": "First-party turnkey client for AgentHub AI Gateway (zero runtime deps; no competitor SDKs)",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": ["src", "README.md"],
  "license": "Apache-2.0",
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenthub/gateway.git",
    "directory": "sdk/js"
  },
  "keywords": ["ai-gateway", "openai-compatible", "observability", "cost", "gateway-native"],
  "scripts": {
    "check": "node --check src/index.js"
  }
}
